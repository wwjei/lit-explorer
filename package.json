{
  "name": "lit-explorer",
  "version": "0.0.10-alpha",
  "private": true,
  "description": "lit explorer —— 面向开发者的本地项目文件浏览器：多栏目录导航 + 内嵌预览，双击用系统默认程序打开",
  "author": {
    "name": "wwjei"
  },
  "scripts": {
    "build": "npm run icons && node scripts/build-renderer.mjs",
    "icons": "node scripts/build-icons.mjs",
    "notices": "node mygo/stage-frontend.mjs",
    "audit": "node scripts/audit-report.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node test/unit.test.cjs && electron test/integration.test.cjs",
    "test:unit": "node test/unit.test.cjs",
    "test:integration": "electron test/integration.test.cjs",
    "prestart": "npm run build",
    "start": "node scripts/run-native.mjs",
    "dev": "npm start",
    "probe": "node scripts/run-probe.mjs",
    "predist": "npm run build",
    "dist": "node scripts/clean-dist.mjs && node scripts/build-mygo.mjs"
  },
  "license": "MIT",
  "//dependencies": "产品主进程由 Go 编译；npm 依赖只用于构建渲染层与测试，Electron 仅用于开发期界面测试，不提供 Electron 产品。",
  "dependencies": {},
  "devDependencies": {
    "docx-preview": "0.4.1",
    "electron": "^44.9.3",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "pptx-preview": "1.0.7",
    "shiki": "4.6.0"
  }
}
