{
  "name": "lit-explorer",
  "version": "0.0.6-alpha",
  "private": true,
  "description": "lit explorer —— 面向开发者的本地项目文件浏览器：多栏目录导航 + 内嵌预览，双击用系统默认程序打开",
  "main": "src/main/main.js",
  "author": {
    "name": "wwjei"
  },
  "scripts": {
    "build": "npm run icons && node scripts/build-renderer.mjs",
    "icons": "node scripts/build-icons.mjs",
    "notices": "node scripts/build-notices.mjs",
    "audit": "node scripts/audit-report.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node test/unit.test.cjs && electron test/integration.test.cjs",
    "test:unit": "node test/unit.test.cjs",
    "test:integration": "electron test/integration.test.cjs",
    "prestart": "npm run build",
    "start": "electron .",
    "dev": "npm run build && electron . --dev",
    "preshot": "npm run build",
    "shot": "electron .",
    "probe": "node scripts/run-probe.mjs",
    "predist": "npm run build && npm run notices",
    "dist": "node scripts/clean-dist.mjs && electron-builder --win --publish never",
    "predist:mygo": "npm run build && npm run notices",
    "dist:mygo": "node scripts/build-mygo.mjs",
    "dist:all": "npm run dist && node scripts/build-mygo.mjs"
  },
  "license": "MIT",
  "//author": "必须是对象形式（author.name）：electron-builder 用 author.name 填 exe 的 CompanyName，写成字符串的话它会取到 undefined，exe 就留着 Electron 原版的厂商信息。",
  "//dependencies": "运行时不需要任何 npm 依赖：主进程只用 electron 与 node 内置模块，shiki / docx-preview / pptx-preview 已由 esbuild 打包进 src/renderer/vendor/。它们放在 devDependencies 里，避免 electron-builder 把 node_modules（其中 echarts+zrender 约 55 MB）打进 app.asar。",
  "dependencies": {},
  "devDependencies": {
    "docx-preview": "0.4.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "pptx-preview": "1.0.7",
    "shiki": "4.5.0"
  },
  "build": {
    "appId": "com.litexplorer.app",
    "productName": "Lit Explorer",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      "LICENSE",
      "FEATURES.md",
      "docs/**/*",
      "!docs/agents/**",
      "!docs/design/**",
      "sample-project/**/*",
      {
        "from": "build/notices",
        "to": "notices"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Lit-Explorer-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "lit explorer",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Lit-Explorer-${version}-portable.${ext}"
    }
  }
}
